# Custom progress indicator with fallback
class ProgressIndicator:
	"""Smart progress indicator that uses tqdm if available, falls back to simple ASCII progress"""

	def __init__(self, iterable=None, total=None, desc=None, disable=False, unit='it', **kwargs):
		self.iterable = iterable
		self.total = total or (len(iterable) if iterable and hasattr(iterable, '__len__') else None)
		self.desc = desc or ''
		self.disable = disable
		self.unit = unit
		self.n = 0
		self.started = False
		self.use_tqdm = TQDM_AVAILABLE and not disable

		if self.use_tqdm:
			self.pbar = tqdm_real(iterable=iterable, total=total, desc=desc, disable=disable, unit=unit, **kwargs)
		else:
			self.pbar = None
			self.last_percent = -1

	def __iter__(self):
		if self.use_tqdm:
			# Iterate through tqdm directly - it handles the progress bar
			yield from self.pbar
		elif not self.iterable:
			return
		else:
			# Use the fallback progress generator
			yield from self._iterate_with_progress()

	def _iterate_with_progress(self):
		"""Generator that yields items with progress updates"""
		self.started = True
		if not self.disable and self.total:
			self._print_progress(0)

		for i, item in enumerate(self.iterable):
			yield item
			self.n = i + 1
			if not self.disable and self.total:
				self._print_progress(self.n)

		if not self.disable:
			self._finish()

	def __enter__(self):
		if self.use_tqdm:
			return self.pbar.__enter__()
		return self

	def __exit__(self, *args):
		if self.use_tqdm:
			return self.pbar.__exit__(*args)
		self._finish()

	def update(self, n=1):
		if self.use_tqdm:
			self.pbar.update(n)
		else:
			self.n += n
			if not self.disable and self.total:
				self._print_progress(self.n)

	def set_description(self, desc):
		self.desc = desc
		if self.use_tqdm:
			self.pbar.set_description(desc)

	def close(self):
		if self.use_tqdm:
			self.pbar.close()
		else:
			self._finish()

	def _print_progress(self, current):
		"""Simple ASCII progress bar fallback"""
		if self.total is None or self.total == 0:
			return

		percent = int((current / self.total) * 100)

		# Only update on percent change to reduce output spam
		if percent != self.last_percent:
			self.last_percent = percent
			bar_length = 40
			filled = int((current / self.total) * bar_length)
			bar = '█' * filled + '░' * (bar_length - filled)

			# Format with description, bar, percentage, and count
			msg = f'\r{self.desc}: [{bar}] {percent}% ({current}/{self.total} {self.unit})'
			print(msg, end='', flush=True)

	def _finish(self):
		"""Complete the progress bar"""
		if not self.disable and not self.use_tqdm and self.total:
			# Print final 100% state
			bar_length = 40
			bar = '█' * bar_length
			print(f'\r{self.desc}: [{bar}] 100% ({self.total}/{self.total} {self.unit})')

# Alias for backward compatibility and easier use
tqdm = ProgressIndicator

