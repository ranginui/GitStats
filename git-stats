class GitStats:
	def __init__(self, args=None):
		self.args = args

	def run(self):
		# Setup logging handler
		handler = logging.StreamHandler()
		if self.args.verbose:
			logger.setLevel(logging.DEBUG)
			handler.setFormatter(logging.Formatter('%(levelname)s: %(message)s'))
		elif self.args.quiet:
			logger.setLevel(logging.WARNING)
			handler.setFormatter(logging.Formatter('%(levelname)s: %(message)s'))
		else:
			logger.setLevel(logging.INFO)
			handler.setFormatter(logging.Formatter('%(message)s'))
		logger.addHandler(handler)

		# Apply configuration overrides
		if self.args.config:
			for config_item in self.args.config:
				key, value = config_item.split('=', 1)
				if key not in conf:
					raise KeyError('Error: no such key "%s" in config' % key)
				if isinstance(conf[key], int):
					conf[key] = int(value)
				else:
					conf[key] = value

		gitpath = self.args.gitpath
		outputpath = os.path.abspath(self.args.outputpath)
		rundir = os.getcwd()

		try:
			os.makedirs(outputpath)
		except OSError:
			pass
		if not os.path.isdir(outputpath):
			logger.error('FATAL: Output path is not a directory or does not exist')
			sys.exit(1)

		logger.info('Git path: %s' % gitpath)
		logger.info('Output path: %s' % outputpath)
		logger.debug('Configuration: %s' % conf)

		os.chdir(gitpath)

		cachefile = os.path.join(outputpath, 'gitstats.cache')

		# Overall progress tracking
		phases = [
			'Loading cache',
			'Collecting data',
			'Refining data',
			'Saving cache',
			'Generating HTML',
			'Creating graphs'
		]
		overall_progress = tqdm(total=len(phases), desc='Overall progress', unit='phase',
								disable=logger.level != logging.INFO, position=0, leave=True)

		overall_progress.set_description('Phase 1/6: Loading cache')
		overall_progress.update(0)
		data = GitDataCollector()
		data.loadCache(cachefile)
		overall_progress.update(1)

		overall_progress.set_description('Phase 2/6: Collecting data')
		data.collect(gitpath, args=self.args)
		overall_progress.update(1)

		overall_progress.set_description('Phase 3/6: Refining data')
		data.refine()
		overall_progress.update(1)

		overall_progress.set_description('Phase 4/6: Saving cache')
		data.saveCache(cachefile)
		overall_progress.update(1)

		os.chdir(rundir)

		overall_progress.set_description('Phase 5/6: Generating HTML')
		report = HTMLReportCreator()
		report.create(data, outputpath)
		overall_progress.update(1)

		overall_progress.set_description('Phase 6/6: Complete')
		overall_progress.update(1)
		overall_progress.close()

		time_end = time.time()
		exectime_internal = time_end - time_start
		logger.info('Execution time %.5f secs, %.5f secs (%.2f %%) in external commands)' % (exectime_internal, exectime_external, (100.0 * exectime_external) / exectime_internal))


def parse_arguments():
	parser = argparse.ArgumentParser(
		description='GitStats - Git repository statistics generator',
		formatter_class=argparse.RawDescriptionHelpFormatter,
		epilog='''
Examples:
  %(prog)s /path/to/repo /path/to/output
  %(prog)s --verbose --since 2024-01-01 /path/to/repo /path/to/output
  %(prog)s --author "John Doe" --branch main /path/to/repo /path/to/output
  %(prog)s -c max_authors=50 /path/to/repo /path/to/output

Configuration keys (use with -c):
  max_authors    - Maximum number of authors to display (default: 20)
  max_domains    - Maximum number of domains to display (default: 10)
  max_ext_length - Maximum extension length (default: 10)
  style          - CSS stylesheet filename (default: gitstats.css)
		'''
	)

	parser.add_argument('gitpath', metavar='GITPATH',
						help='path to git repository')
	parser.add_argument('outputpath', metavar='OUTPUTPATH',
						help='path to output directory')

	parser.add_argument('--version', action='version', version='%(prog)s ' + __version__)

	# Logging options
	log_group = parser.add_mutually_exclusive_group()
	log_group.add_argument('-v', '--verbose', action='store_true',
						   help='enable verbose output (DEBUG level)')
	log_group.add_argument('-q', '--quiet', action='store_true',
						   help='show only warnings and errors')

	# Configuration options
	parser.add_argument('-c', '--config', action='append', metavar='KEY=VALUE',
						help='override configuration value (can be used multiple times)')

	# Filtering options
	filter_group = parser.add_argument_group('filtering options')
	filter_group.add_argument('--since', metavar='DATE',
							  help='analyze commits since date (YYYY-MM-DD or "YYYY-MM-DD HH:MM:SS")')
	filter_group.add_argument('--until', metavar='DATE',
							  help='analyze commits until date (YYYY-MM-DD or "YYYY-MM-DD HH:MM:SS")')
	filter_group.add_argument('--author', metavar='PATTERN',
							  help='filter commits by author name (regex pattern)')
	filter_group.add_argument('--branch', metavar='BRANCH', default='HEAD',
							  help='analyze specific branch (default: HEAD)')

	# Output options
	output_group = parser.add_argument_group('output options')
	output_group.add_argument('--no-cache', action='store_true',
							  help='do not use or save cache')

	return parser.parse_args()


def main():
	args = parse_arguments()
	g = GitStats(args)
	g.run()


if __name__ == '__main__':
	main()

