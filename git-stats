def getpipeoutput(cmds, quiet = False):
	global exectime_external
	start = time.time()
	if not quiet and ON_LINUX and os.isatty(1):
		print('>> ' + ' | '.join(cmds), end=' ')
		sys.stdout.flush()
	p0 = subprocess.Popen(cmds[0], stdout = subprocess.PIPE, shell = True)
	p = p0
	for x in cmds[1:]:
		p = subprocess.Popen(x, stdin = p0.stdout, stdout = subprocess.PIPE, shell = True)
		p0 = p
	output = p.communicate()[0]
	end = time.time()
	if not quiet:
		if ON_LINUX and os.isatty(1):
			print('\r', end=' ')
		print('[%.5f] >> %s' % (end - start, ' | '.join(cmds)))
	exectime_external += (end - start)
	return output.decode('utf-8', errors='replace').rstrip('\n')

def getpipeoutput_streaming(cmds, quiet=False):
	"""
	Memory-efficient version of getpipeoutput that yields lines instead of
	loading entire output into memory. Use for large git outputs.
	"""
	global exectime_external
	start = time.time()
	if not quiet and ON_LINUX and os.isatty(1):
		print('>> ' + ' | '.join(cmds), end=' ')
		sys.stdout.flush()

	p0 = subprocess.Popen(cmds[0], stdout=subprocess.PIPE, shell=True, bufsize=1, universal_newlines=True)
	p = p0
	for x in cmds[1:]:
		p = subprocess.Popen(x, stdin=p0.stdout, stdout=subprocess.PIPE, shell=True, bufsize=1, universal_newlines=True)
		p0.stdout.close()  # Allow p0 to receive SIGPIPE if p exits
		p0 = p

	try:
		for line in p.stdout:
			yield line.rstrip('\n')
	finally:
		p.stdout.close()
		p.wait()
		end = time.time()
		if not quiet:
			if ON_LINUX and os.isatty(1):
				print('\r', end=' ')
			print('[%.5f] >> %s' % (end - start, ' | '.join(cmds)))
		exectime_external += (end - start)

def getkeyssortedbyvalues(dict):
	return list(map(lambda el : el[1], sorted(map(lambda el : (el[1], el[0]), dict.items()))))

# dict['author'] = { 'commits': 512 } - ...key(dict, 'commits')
def getkeyssortedbyvaluekey(d, key):
	return list(map(lambda el : el[1], sorted(map(lambda el : (d[el][key], el), list(d.keys())))))

VERSION = 0
def getversion():
	global VERSION
	if VERSION == 0:
		VERSION = getpipeoutput(["git rev-parse --short HEAD"]).split('\n')[0]
	return VERSION

class DataCollector:
	"""Manages data collection from a revision control repository."""
	CACHE_VERSION = 2  # Increment when cache structure changes

	def __init__(self):
		self.stamp_created = time.time()
		self.cache = {}
		self.cache_metadata = {
			'version': self.CACHE_VERSION,
			'last_commit_hash': None,
			'repository_path': None,
			'last_update': None
		}
	
	##
	# This should be the main function to extract data from the repository.
	def collect(self, dir):
		self.dir = dir
		self.projectname = os.path.basename(os.path.abspath(dir))
	
	##
	# Load cacheable data
	def loadCache(self, cachefile):
		if not os.path.exists(cachefile):
			return
		logger.info('Loading cache...')
		with open(cachefile, 'rb') as f:
			try:
				cache_data = pickle.loads(zlib.decompress(f.read()))
			except Exception:
				# temporary hack to upgrade non-compressed caches
				f.seek(0)
				try:
					cache_data = pickle.load(f)
				except Exception as e:
					logger.warning('Failed to load cache: %s' % str(e))
					return

		# Handle old cache format (dict) vs new format (tuple with metadata)
		if isinstance(cache_data, dict):
			# Old cache format - no metadata
			self.cache = cache_data
			logger.info('Loaded old cache format (will be upgraded on save)')
		elif isinstance(cache_data, tuple) and len(cache_data) == 2:
			# New cache format with metadata
			self.cache, self.cache_metadata = cache_data
			cache_version = self.cache_metadata.get('version', 1)

			# Validate cache version
			if cache_version != self.CACHE_VERSION:
				logger.warning('Cache version mismatch (cache: %d, current: %d) - invalidating cache' %
					(cache_version, self.CACHE_VERSION))
				self.cache = {}
				self.cache_metadata = {
					'version': self.CACHE_VERSION,
					'last_commit_hash': None,
					'repository_path': None,
					'last_update': None
				}
			else:
				logger.info('Loaded cache from last commit: %s' %
					(self.cache_metadata.get('last_commit_hash', 'unknown')[:7]
					 if self.cache_metadata.get('last_commit_hash') else 'none'))
		else:
			logger.warning('Unknown cache format - invalidating cache')
			self.cache = {}
	
	##
	# Produce any additional statistics from the extracted data.
	def refine(self):
		pass

	##
	# : get a dictionary of author
	def getAuthorInfo(self, author):
		return None
	
	def getActivityByDayOfWeek(self):
		return {}

	def getActivityByHourOfDay(self):
		return {}

	# : get a dictionary of domains
	def getDomainInfo(self, domain):
		return None

	##
	# Get a list of authors
	def getAuthors(self):
		return []
	
	def getFirstCommitDate(self):
		return datetime.datetime.now()
	
	def getLastCommitDate(self):
		return datetime.datetime.now()
	
	def getStampCreated(self):
		return self.stamp_created
	
	def getTags(self):
		return []
	
	def getTotalAuthors(self):
		return -1
	
	def getTotalCommits(self):
		return -1
		
	def getTotalFiles(self):
		return -1
	
	def getTotalLOC(self):
		return -1
	
	##
	# Save cacheable data
	def saveCache(self, cachefile):
		logger.info('Saving cache...')
		# Update metadata timestamp
		self.cache_metadata['last_update'] = time.time()

		with open(cachefile, 'wb') as f:
			# Save as tuple: (cache_dict, metadata_dict)
			cache_data = (self.cache, self.cache_metadata)
			data = zlib.compress(pickle.dumps(cache_data))
			f.write(data)

		if self.cache_metadata.get('last_commit_hash'):
			logger.info('Cache saved with last commit: %s' %
				self.cache_metadata['last_commit_hash'][:7])

class GitDataCollector(DataCollector):
	def _build_git_log_filter(self, args):
		"""Build git log filter arguments from command line args"""
		filters = []
		if hasattr(args, 'since') and args.since:
			filters.append('--since="%s"' % args.since)
		if hasattr(args, 'until') and args.until:
			filters.append('--until="%s"' % args.until)
		if hasattr(args, 'author') and args.author:
			filters.append('--author="%s"' % args.author)
		if hasattr(args, 'branch') and args.branch:
			branch = args.branch
		else:
			branch = 'HEAD'
		return ' '.join(filters), branch

	def _get_new_commits(self, git_branch='HEAD'):
		"""
		Check if there are new commits since last cache update.
		Returns (has_new_commits, commit_range_filter)
		"""
		last_commit = self.cache_metadata.get('last_commit_hash')

		if not last_commit:
			# No previous cache, process all commits
			logger.info('No previous cache found - will process all commits')
			return True, ''

		# Check if last_commit still exists in the repository
		try:
			getpipeoutput(['git cat-file -e %s' % last_commit])
		except Exception:
			logger.warning('Last cached commit %s not found - will process all commits' % last_commit[:7])
			return True, ''

		# Get current HEAD
		try:
			current_head = getpipeoutput(['git rev-parse %s' % git_branch]).strip()
		except Exception:
			logger.warning('Could not determine current HEAD - will process all commits')
			return True, ''

		if current_head == last_commit:
			logger.info('Repository unchanged since last run (at %s)' % current_head[:7])
			return False, ''

		# Count new commits
		try:
			new_commit_count = int(getpipeoutput(['git rev-list --count %s..%s' % (last_commit, git_branch)]).strip())
		except Exception:
			new_commit_count = 0

		if new_commit_count == 0:
			logger.info('No new commits to process')
			return False, ''

		logger.info('Found %d new commits since last run (%s..%s)' %
			(new_commit_count, last_commit[:7], current_head[:7]))

		# Return filter to only process new commits
		return True, '%s..%s' % (last_commit, git_branch)

	def collect(self, dir, args=None):
		DataCollector.collect(self, dir)

		# Build git filter arguments
		git_filter = ''
		git_branch = 'HEAD'
		if args:
			git_filter, git_branch = self._build_git_log_filter(args)

		logger.debug('Git filter: %s' % git_filter if git_filter else 'Git filter: (none)')
		logger.debug('Git branch: %s' % git_branch)

		# Check for incremental update opportunity
		# Note: User-specified filters override incremental mode
		has_new_commits = True
		if not git_filter:
			has_new_commits, _ = self._get_new_commits(git_branch)
			if not has_new_commits:
				logger.info('No new data to collect - using cached data')
				return

		# Parse date filters for tag filtering
		since_stamp = None
		until_stamp = None
		if args:
			if hasattr(args, 'since') and args.since:
				try:
					since_stamp = int(getpipeoutput(['git log --since="%s" --pretty=format:"%%at" -n 1' % args.since]))
				except Exception:
					pass
			if hasattr(args, 'until') and args.until:
				try:
					until_stamp = int(getpipeoutput(['git log --until="%s" --pretty=format:"%%at" -n 1' % args.until]))
				except Exception:
					pass

		try:
			cmd = 'git log %s %s' % (git_filter, git_branch)
			self.total_authors = int(getpipeoutput([cmd, 'git shortlog -s', 'wc -l']))
		except Exception:
			self.total_authors = 0
		#self.total_lines = int(getoutput('git-ls-files -z |xargs -0 cat |wc -l'))

		self.activity_by_hour_of_day = {} # hour -> commits
		self.activity_by_day_of_week = {} # day -> commits
		self.activity_by_month_of_year = {} # month [1-12] -> commits
		self.activity_by_hour_of_week = {} # weekday -> hour -> commits
		self.activity_by_hour_of_day_busiest = 0
		self.activity_by_hour_of_week_busiest = 0
		self.activity_by_year_week = {} # yy_wNN -> commits
		self.activity_by_year_week_peak = 0

		self.authors = {} # name -> {commits, first_commit_stamp, last_commit_stamp, last_active_day, active_days, lines_added, lines_removed}

		# domains
		self.domains = {} # domain -> commits

		# author of the month
		self.author_of_month = {} # month -> author -> commits
		self.author_of_year = {} # year -> author -> commits
		self.commits_by_month = {} # month -> commits
		self.commits_by_year = {} # year -> commits
		self.first_commit_stamp = 0
		self.last_commit_stamp = 0
		self.last_active_day = None
		self.active_days = set()

		# lines
		self.total_lines = 0
		self.total_lines_added = 0
		self.total_lines_removed = 0

		# Code churn analysis
		self.churn_by_date = {} # date -> { 'added': lines, 'removed': lines, 'net': lines, 'churn': lines }
		self.churn_by_month = {} # YYYY-MM -> { 'added': lines, 'removed': lines, 'net': lines, 'churn': lines }
		self.max_churn_day = (None, 0) # (date, churn_value)
		self.max_net_growth_day = (None, 0) # (date, net_growth)
		self.refactoring_periods = [] # list of (date, churn_ratio, net_change) where heavy refactoring occurred

		# File volatility metrics
		self.file_changes = {} # filename -> { 'changes': count, 'authors': set(), 'last_change': stamp, 'lines_changed': total }
		self.file_hotspots = [] # list of (filename, change_count) sorted by changes

		# Commit size distribution
		self.commit_sizes = [] # list of (commit_hash, size_category, lines_changed, files_changed)
		self.size_categories = {
			'tiny': 0,      # 1-10 lines
			'small': 0,     # 11-50 lines
			'medium': 0,    # 51-200 lines
			'large': 0,     # 201-500 lines
			'huge': 0       # 500+ lines
		}
		self.commits_by_size = {}  # size_category -> list of commit info

		# Author collaboration metrics
		self.author_pairs = {}  # (author1, author2) -> { 'files': set(), 'collaboration_count': int }
		self.knowledge_silos = []  # list of (filename, sole_author, changes)
		self.collaboration_files = []  # list of (filename, author_count, authors)

		# timezone
		self.commits_by_timezone = {} # timezone -> commits

		# tags
		self.tags = {}
		lines = getpipeoutput(['git show-ref --tags']).split('\n')
		tag_lines = [l for l in lines if l]
		logger.debug('Processing %d tags (will filter by date if applicable)' % len(tag_lines))
		for line in tqdm(tag_lines, desc='Processing tags', unit='tags', disable=logger.level > logging.INFO):
			(hash, tag) = line.split(' ')

			tag = tag.replace('refs/tags/', '')
			output = getpipeoutput(['git log "%s" --pretty=format:"%%at %%aN" -n 1' % hash], quiet=True)
			if len(output) > 0:
				parts = output.split(' ')
				stamp = 0
				try:
					stamp = int(parts[0])
				except ValueError:
					stamp = 0

				# Filter tags by date range if specified
				if since_stamp is not None and stamp < since_stamp:
					continue
				if until_stamp is not None and stamp > until_stamp:
					continue

				self.tags[tag] = { 'stamp': stamp, 'hash' : hash, 'date' : datetime.datetime.fromtimestamp(stamp).strftime('%Y-%m-%d'), 'commits': 0, 'authors': {} }

		# collect info on tags, starting from latest
		tags_sorted_by_date_desc = list(map(lambda el : el[1], reversed(sorted(map(lambda el : (el[1]['date'], el[0]), self.tags.items())))))
		prev = None
		if len(tags_sorted_by_date_desc) > 0:
			logger.debug('Collecting statistics for %d filtered tags' % len(tags_sorted_by_date_desc))
		for tag in reversed(tags_sorted_by_date_desc):
			cmd = 'git shortlog -s "%s"' % tag
			if prev != None:
				cmd += ' "^%s"' % prev
			output = getpipeoutput([cmd], quiet=True)
			if len(output) == 0:
				continue
			prev = tag
			for line in output.split('\n'):
				parts = re.split('\s+', line, 2)
				commits = int(parts[1])
				author = parts[2]
				self.tags[tag]['commits'] += commits
				self.tags[tag]['authors'][author] = commits

		# Collect revision statistics
		# Outputs "<stamp> <date> <time> <timezone> <author> '<' <mail> '>'"
		# Note: Using %aN and %aE (capital letters) to respect .mailmap
		cmd = 'git log --pretty=format:"%%at %%ai %%aN <%%aE>" %s %s' % (git_filter, git_branch)
		lines = getpipeoutput([cmd, 'grep -v ^commit']).split('\n')
		commit_lines = [l for l in lines if l]
		logger.info('Processing %d commits...' % len(commit_lines))
		for line in tqdm(commit_lines, desc='Analyzing commits', unit='commits', disable=logger.level > logging.INFO):
			try:
				parts = line.split(' ', 4)
				author = ''
				try:
					stamp = int(parts[0])
				except ValueError:
					stamp = 0
				timezone = parts[3]
				author, mail = parts[4].split('<', 1)
			except Exception as e:
				logger.debug('Error processing commit line: %s - %s' % (line, str(e)))
				continue
			author = author.rstrip()
			mail = mail.rstrip('>')
			domain = '?'
			if mail.find('@') != -1:
				domain = mail.rsplit('@', 1)[1]
			date = datetime.datetime.fromtimestamp(float(stamp))

			# First and last commit stamp
			if self.last_commit_stamp == 0:
				self.last_commit_stamp = stamp
			self.first_commit_stamp = stamp

			# activity
			# hour
			hour = date.hour
			self.activity_by_hour_of_day[hour] = self.activity_by_hour_of_day.get(hour, 0) + 1
			# most active hour?
			if self.activity_by_hour_of_day[hour] > self.activity_by_hour_of_day_busiest:
				self.activity_by_hour_of_day_busiest = self.activity_by_hour_of_day[hour]

			# day of week
			day = date.weekday()
			self.activity_by_day_of_week[day] = self.activity_by_day_of_week.get(day, 0) + 1

			# domain stats
			if domain not in self.domains:
				self.domains[domain] = {}
			# commits
			self.domains[domain]['commits'] = self.domains[domain].get('commits', 0) + 1

			# hour of week
			if day not in self.activity_by_hour_of_week:
				self.activity_by_hour_of_week[day] = {}
			self.activity_by_hour_of_week[day][hour] = self.activity_by_hour_of_week[day].get(hour, 0) + 1
			# most active hour?
			if self.activity_by_hour_of_week[day][hour] > self.activity_by_hour_of_week_busiest:
				self.activity_by_hour_of_week_busiest = self.activity_by_hour_of_week[day][hour]

			# month of year
			month = date.month
			self.activity_by_month_of_year[month] = self.activity_by_month_of_year.get(month, 0) + 1

			# yearly/weekly activity
			yyw = date.strftime('%Y-%W')
			self.activity_by_year_week[yyw] = self.activity_by_year_week.get(yyw, 0) + 1
			if self.activity_by_year_week_peak < self.activity_by_year_week[yyw]:
				self.activity_by_year_week_peak = self.activity_by_year_week[yyw]

			# author stats
			if author not in self.authors:
				self.authors[author] = {}
			# commits
			if 'last_commit_stamp' not in self.authors[author]:
				self.authors[author]['last_commit_stamp'] = stamp
			self.authors[author]['first_commit_stamp'] = stamp
			self.authors[author]['commits'] = self.authors[author].get('commits', 0) + 1

			# author of the month/year
			yymm = date.strftime('%Y-%m')
			if yymm in self.author_of_month:
				self.author_of_month[yymm][author] = self.author_of_month[yymm].get(author, 0) + 1
			else:
				self.author_of_month[yymm] = {}
				self.author_of_month[yymm][author] = 1
			self.commits_by_month[yymm] = self.commits_by_month.get(yymm, 0) + 1

			yy = date.year
			if yy in self.author_of_year:
				self.author_of_year[yy][author] = self.author_of_year[yy].get(author, 0) + 1
			else:
				self.author_of_year[yy] = {}
				self.author_of_year[yy][author] = 1
			self.commits_by_year[yy] = self.commits_by_year.get(yy, 0) + 1

			# authors: active days
			yymmdd = date.strftime('%Y-%m-%d')
			if 'last_active_day' not in self.authors[author]:
				self.authors[author]['last_active_day'] = yymmdd
				self.authors[author]['active_days'] = 1
			elif yymmdd != self.authors[author]['last_active_day']:
				self.authors[author]['last_active_day'] = yymmdd
				self.authors[author]['active_days'] += 1

			# project: active days
			if yymmdd != self.last_active_day:
				self.last_active_day = yymmdd
				self.active_days.add(yymmdd)

			# timezone
			self.commits_by_timezone[timezone] = self.commits_by_timezone.get(timezone, 0) + 1

		# Parallel file counting (optimized from previous bottleneck)
		# outputs "<stamp> <files>" for each revision
		self.files_by_stamp = {} # stamp -> files
		cmd = 'git rev-list --pretty=format:"%%at %%T" %s %s' % (git_filter, git_branch)
		revlines = getpipeoutput([cmd, 'grep -v ^commit']).strip().split('\n')
		lines = []
		logger.info('Counting files in %d revisions...' % len(revlines))

		# Helper function for parallel execution
		def count_files_for_rev(revline):
			time, rev = revline.split(' ')
			linecount = self.getFilesInCommit(rev)
			return '%d %d' % (int(time), linecount)

		# Use parallel processing with progress bar
		with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as executor:
			futures = {executor.submit(count_files_for_rev, revline): revline for revline in revlines}
			pbar = tqdm(total=len(futures), desc='Counting files', unit='revisions', disable=logger.level > logging.INFO)

			for future in as_completed(futures):
				try:
					result = future.result()
					lines.append(result)
				except Exception as e:
					logger.warning('Failed to count files for revision: %s' % str(e))
				pbar.update(1)
			pbar.close()

		self.total_commits = len(lines)
		for line in lines:
			parts = line.split(' ')
			if len(parts) != 2:
				continue
			(stamp, files) = parts[0:2]
			try:
				self.files_by_stamp[int(stamp)] = int(files)
			except ValueError:
				logger.warning('Failed to parse line "%s"' % line)

		# extensions - parallel analysis
		self.extensions = {} # extension -> files, lines
		lines = getpipeoutput(['git ls-tree -r -z %s' % git_branch]).split('\000')
		file_lines = [l for l in lines if l]
		self.total_files = len(file_lines)
		logger.info('Analyzing %d files...' % self.total_files)

		# Helper function for parallel extension analysis
		def analyze_file_extension(line):
			parts = re.split('\s+', line, 4)
			sha1 = parts[2]
			filename = parts[3]

			if filename.find('.') == -1 or filename.rfind('.') == 0:
				ext = ''
			else:
				ext = filename[(filename.rfind('.') + 1):]
			if len(ext) > conf['max_ext_length']:
				ext = ''

			try:
				line_count = self.getLinesInBlob(sha1)
			except Exception:
				logger.warning('Could not count lines for file "%s"' % line)
				line_count = 0

			return (ext, line_count)

		# Use parallel processing with progress bar
		with ThreadPoolExecutor(max_workers=os.cpu_count() or 4) as executor:
			futures = {executor.submit(analyze_file_extension, line): line for line in file_lines}
			pbar = tqdm(total=len(futures), desc='Analyzing extensions', unit='files', disable=logger.level > logging.INFO)

			for future in as_completed(futures):
				try:
					ext, line_count = future.result()
					if ext not in self.extensions:
						self.extensions[ext] = {'files': 0, 'lines': 0}
					self.extensions[ext]['files'] += 1
					self.extensions[ext]['lines'] += line_count
				except Exception as e:
					logger.warning('Failed to analyze file: %s' % str(e))
				pbar.update(1)
			pbar.close()

		# line statistics
		# outputs:
		#  N files changed, N insertions (+), N deletions(-)
		# <stamp> <author>
		self.changes_by_date = {} # stamp -> { files, ins, del }
		cmd = 'git log %s %s --shortstat --pretty=format:"%%at %%aN"' % (git_filter, git_branch)
		lines = getpipeoutput([cmd]).split('\n')
		lines.reverse()
		logger.info('Calculating line statistics (%d entries)...' % len(lines))
		files = 0; inserted = 0; deleted = 0; total_lines = 0
		author = None

		# Add progress bar for line statistics processing
		pbar = tqdm(total=len(lines), desc='Processing line stats', unit='lines', disable=logger.level > logging.INFO)
		for line in lines:
			pbar.update(1)
			if len(line) == 0:
				continue

			# <stamp> <author>
			if line.find('files changed,') == -1:
				pos = line.find(' ')
				if pos != -1:
					try:
						(stamp, author) = (int(line[:pos]), line[pos+1:])
						self.changes_by_date[stamp] = { 'files': files, 'ins': inserted, 'del': deleted, 'lines': total_lines }
						if author not in self.authors:
							self.authors[author] = { 'lines_added' : 0, 'lines_removed' : 0 }
						self.authors[author]['lines_added'] = self.authors[author].get('lines_added', 0) + inserted
						self.authors[author]['lines_removed'] = self.authors[author].get('lines_removed', 0) + deleted

						# Track code churn by date
						if inserted > 0 or deleted > 0:
							date_str = datetime.datetime.fromtimestamp(stamp).strftime('%Y-%m-%d')
							month_str = datetime.datetime.fromtimestamp(stamp).strftime('%Y-%m')

							# Daily churn
							if date_str not in self.churn_by_date:
								self.churn_by_date[date_str] = { 'added': 0, 'removed': 0, 'net': 0, 'churn': 0 }
							self.churn_by_date[date_str]['added'] += inserted
							self.churn_by_date[date_str]['removed'] += deleted
							self.churn_by_date[date_str]['net'] = self.churn_by_date[date_str]['added'] - self.churn_by_date[date_str]['removed']
							self.churn_by_date[date_str]['churn'] = self.churn_by_date[date_str]['added'] + self.churn_by_date[date_str]['removed']

							# Monthly churn
							if month_str not in self.churn_by_month:
								self.churn_by_month[month_str] = { 'added': 0, 'removed': 0, 'net': 0, 'churn': 0 }
							self.churn_by_month[month_str]['added'] += inserted
							self.churn_by_month[month_str]['removed'] += deleted
							self.churn_by_month[month_str]['net'] = self.churn_by_month[month_str]['added'] - self.churn_by_month[month_str]['removed']
							self.churn_by_month[month_str]['churn'] = self.churn_by_month[month_str]['added'] + self.churn_by_month[month_str]['removed']

							# Track commit size distribution
							total_changes = inserted + deleted
							if total_changes > 0:
								# Categorize commit by size
								if total_changes <= 10:
									category = 'tiny'
								elif total_changes <= 50:
									category = 'small'
								elif total_changes <= 200:
									category = 'medium'
								elif total_changes <= 500:
									category = 'large'
								else:
									category = 'huge'

								self.size_categories[category] += 1
								commit_info = {
									'stamp': stamp,
									'author': author,
									'files': files,
									'lines': total_changes,
									'category': category
								}
								if category not in self.commits_by_size:
									self.commits_by_size[category] = []
								self.commits_by_size[category].append(commit_info)

					except ValueError:
						logger.debug('Unexpected line "%s"' % line)
				else:
					logger.debug('Unexpected line "%s"' % line)
			else:
				numbers = re.findall('\d+', line)
				if len(numbers) == 3:
					(files, inserted, deleted) = list(map(lambda el : int(el), numbers))
					total_lines += inserted
					total_lines -= deleted
					self.total_lines_added += inserted
					self.total_lines_removed += deleted
				else:
					logger.debug('Failed to handle line "%s"' % line)
					(files, inserted, deleted) = (0, 0, 0)
				#self.changes_by_date[stamp] = { 'files': files, 'ins': inserted, 'del': deleted }
		pbar.close()
		self.total_lines = total_lines

		# Collect file volatility metrics
		# Use git log --numstat to get per-file changes
		logger.info('Analyzing file volatility...')
		cmd = 'git log %s %s --numstat --pretty=format:"%%at %%aN"' % (git_filter, git_branch)
		lines = getpipeoutput([cmd]).split('\n')

		current_stamp = None
		current_author = None
		for line in tqdm(lines, desc='Processing file changes', unit='lines', disable=logger.level > logging.INFO):
			if len(line) == 0:
				continue

			# Check if this is a commit line (stamp author)
			if not line.startswith('\t') and line.find('\t') == -1:
				parts = line.split(' ', 1)
				if len(parts) >= 2:
					try:
						current_stamp = int(parts[0])
						current_author = parts[1]
					except ValueError:
						pass
				continue

			# This is a file change line: "added\tdeleted\tfilename"
			parts = line.split('\t')
			if len(parts) >= 3:
				try:
					added = int(parts[0]) if parts[0] != '-' else 0
					deleted = int(parts[1]) if parts[1] != '-' else 0
					filename = parts[2]

					if filename not in self.file_changes:
						self.file_changes[filename] = {
							'changes': 0,
							'authors': set(),
							'last_change': 0,
							'lines_changed': 0
						}

					self.file_changes[filename]['changes'] += 1
					self.file_changes[filename]['authors'].add(current_author)
					self.file_changes[filename]['last_change'] = max(self.file_changes[filename]['last_change'], current_stamp or 0)
					self.file_changes[filename]['lines_changed'] += added + deleted
				except (ValueError, IndexError):
					pass

		# Save current commit hash for incremental updates
		try:
			current_head = getpipeoutput(['git rev-parse %s' % git_branch]).strip()
			self.cache_metadata['last_commit_hash'] = current_head
			self.cache_metadata['repository_path'] = os.path.abspath(dir)
			logger.debug('Saved current HEAD for incremental updates: %s' % current_head[:7])
		except Exception as e:
			logger.warning('Could not save current HEAD: %s' % str(e))

	def refine(self):
		# authors
		# name -> {place_by_commits, commits_frac, date_first, date_last, timedelta}
		authors_by_commits = getkeyssortedbyvaluekey(self.authors, 'commits')
		authors_by_commits.reverse() # most first
		for i, name in enumerate(authors_by_commits):
			self.authors[name]['place_by_commits'] = i + 1

		for name in list(self.authors.keys()):
			a = self.authors[name]
			a['commits_frac'] = (100 * float(a['commits'])) / self.getTotalCommits()
			date_first = datetime.datetime.fromtimestamp(a['first_commit_stamp'])
			date_last = datetime.datetime.fromtimestamp(a['last_commit_stamp'])
			delta = date_last - date_first
			a['date_first'] = date_first.strftime('%Y-%m-%d')
			a['date_last'] = date_last.strftime('%Y-%m-%d')
			a['timedelta'] = delta

			# Calculate churn rate by author (total churn / total commits)
			total_churn = a.get('lines_added', 0) + a.get('lines_removed', 0)
			a['churn'] = total_churn
			a['churn_rate'] = total_churn / a['commits'] if a['commits'] > 0 else 0

		# Analyze code churn patterns
		for date_str, churn_data in self.churn_by_date.items():
			churn_val = churn_data['churn']
			net_val = churn_data['net']

			# Track max churn day
			if churn_val > self.max_churn_day[1]:
				self.max_churn_day = (date_str, churn_val)

			# Track max net growth day
			if net_val > self.max_net_growth_day[1]:
				self.max_net_growth_day = (date_str, net_val)

			# Detect refactoring periods (high churn, low/negative net growth)
			# Refactoring: churn > 100 lines and net growth < 10% of churn
			if churn_val > 100 and abs(net_val) < (churn_val * 0.1):
				churn_ratio = churn_data['removed'] / churn_val if churn_val > 0 else 0
				self.refactoring_periods.append((date_str, churn_ratio, net_val))

		# Sort refactoring periods by churn ratio (highest first)
		self.refactoring_periods.sort(key=lambda x: x[1], reverse=True)

		# Analyze file volatility and create hotspots list
		self.file_hotspots = []
		for filename, data in self.file_changes.items():
			# Convert authors set to count for sorting
			author_count = len(data['authors'])
			self.file_hotspots.append({
				'filename': filename,
				'changes': data['changes'],
				'authors': author_count,
				'last_change': data['last_change'],
				'lines_changed': data['lines_changed']
			})

		# Sort by number of changes (hotspots)
		self.file_hotspots.sort(key=lambda x: x['changes'], reverse=True)

		# Analyze author collaboration patterns
		for filename, data in self.file_changes.items():
			authors_list = list(data['authors'])
			author_count = len(authors_list)

			# Identify knowledge silos (files with only one author)
			if author_count == 1:
				self.knowledge_silos.append({
					'filename': filename,
					'author': authors_list[0],
					'changes': data['changes']
				})
			# Identify collaboration files (files with multiple authors)
			elif author_count > 1:
				self.collaboration_files.append({
					'filename': filename,
					'author_count': author_count,
					'authors': authors_list,
					'changes': data['changes']
				})

				# Track author pairs who collaborate
				for i in range(len(authors_list)):
					for j in range(i + 1, len(authors_list)):
						# Sort authors to ensure consistent pair key
						author1, author2 = sorted([authors_list[i], authors_list[j]])
						pair_key = (author1, author2)

						if pair_key not in self.author_pairs:
							self.author_pairs[pair_key] = {
								'files': set(),
								'collaboration_count': 0
							}

						self.author_pairs[pair_key]['files'].add(filename)
						self.author_pairs[pair_key]['collaboration_count'] = len(self.author_pairs[pair_key]['files'])

		# Sort collaboration files by author count (most collaborative first)
		self.collaboration_files.sort(key=lambda x: x['author_count'], reverse=True)

		# Sort knowledge silos by number of changes (most changed silos first)
		self.knowledge_silos.sort(key=lambda x: x['changes'], reverse=True)

	def getActiveDays(self):
		return self.active_days

	def getActivityByDayOfWeek(self):
		return self.activity_by_day_of_week

	def getActivityByHourOfDay(self):
		return self.activity_by_hour_of_day

	def getAuthorInfo(self, author):
		return self.authors[author]
	
	def getAuthors(self, limit = None):
		res = getkeyssortedbyvaluekey(self.authors, 'commits')
		res.reverse()
		return res[:limit]
	
	def getCommitDeltaDays(self):
		return (self.last_commit_stamp - self.first_commit_stamp) // 86400 + 1

	def getDomainInfo(self, domain):
		return self.domains[domain]

	def getDomains(self):
		return list(self.domains.keys())
	
	def getFilesInCommit(self, rev):
		try:
			res = self.cache['files_in_tree'][rev]
		except Exception:
			res = int(getpipeoutput(['git ls-tree -r --name-only "%s"' % rev, 'wc -l']).split('\n')[0])
			if 'files_in_tree' not in self.cache:
				self.cache['files_in_tree'] = {}
			self.cache['files_in_tree'][rev] = res

		return res

	def getFirstCommitDate(self):
		return datetime.datetime.fromtimestamp(self.first_commit_stamp)
	
	def getLastCommitDate(self):
		return datetime.datetime.fromtimestamp(self.last_commit_stamp)
	
	def getLinesInBlob(self, sha1):
		try:
			res = self.cache['lines_in_blob'][sha1]
		except Exception:
			res = int(getpipeoutput(['git cat-file blob %s' % sha1, 'wc -l']).split()[0])
			if 'lines_in_blob' not in self.cache:
				self.cache['lines_in_blob'] = {}
			self.cache['lines_in_blob'][sha1] = res
		return res

	def getTags(self):
		lines = getpipeoutput(['git show-ref --tags', 'cut -d/ -f3'])
		return lines.split('\n')
	
	def getTagDate(self, tag):
		return self.revToDate('tags/' + tag)
	
	def getTotalAuthors(self):
		return self.total_authors
	
	def getTotalCommits(self):
		return self.total_commits

	def getTotalFiles(self):
		return self.total_files
	
	def getTotalLOC(self):
		return self.total_lines
	
	def revToDate(self, rev):
		stamp = int(getpipeoutput(['git log --pretty=format:%%at "%s" -n 1' % rev]))
		return datetime.datetime.fromtimestamp(stamp).strftime('%Y-%m-%d')

class ReportCreator:
	"""Creates the actual report based on given data."""
	def __init__(self):
		pass
	
	def create(self, data, path):
		self.data = data
		self.path = path

def html_linkify(text):
	return text.lower().replace(' ', '_')

def html_header(level, text):
	name = html_linkify(text)
	return '\n<h%d><a href="#%s" name="%s">%s</a></h%d>\n\n' % (level, name, name, text, level)

class HTMLReportCreator(ReportCreator):
	def create(self, data, path):
		ReportCreator.create(self, data, path)
		self.title = data.projectname

		# copy static files. Looks in the binary directory, ../share/gitstats and /usr/share/gitstats
		binarypath = os.path.dirname(os.path.abspath(__file__))
		secondarypath = os.path.join(binarypath, '..', 'share', 'gitstats')
		basedirs = [binarypath, secondarypath, '/usr/share/gitstats']
		for file in ('gitstats.css', 'sortable.js', 'arrow-up.gif', 'arrow-down.gif', 'arrow-none.gif'):
			for base in basedirs:
				src = base + '/' + file
				if os.path.exists(src):
					shutil.copyfile(src, path + '/' + file)
					break
			else:
				logger.warning('"%s" not found, so not copied (searched: %s)' % (file, basedirs))

		f = open(path + "/index.html", 'w')
		format = '%Y-%m-%d %H:%M:%S'
		self.printHeader(f)

		f.write('<h1>GitStats - %s</h1>' % data.projectname)

		self.printNav(f)

		f.write('<dl>')
		f.write('<dt>Project name</dt><dd>%s</dd>' % (data.projectname))
		f.write('<dt>Generated</dt><dd>%s (in %d seconds)</dd>' % (datetime.datetime.now().strftime(format), time.time() - data.getStampCreated()))
		f.write('<dt>Generator</dt><dd><a href="http://gitstats.sourceforge.net/">GitStats</a> (version %s)</dd>' % getversion())
		f.write('<dt>Report Period</dt><dd>%s to %s</dd>' % (data.getFirstCommitDate().strftime(format), data.getLastCommitDate().strftime(format)))
		f.write('<dt>Age</dt><dd>%d days, %d active days (%3.2f%%)</dd>' % (data.getCommitDeltaDays(), len(data.getActiveDays()), (100.0 * len(data.getActiveDays()) / data.getCommitDeltaDays())))
		f.write('<dt>Total Files</dt><dd>%s</dd>' % data.getTotalFiles())
		f.write('<dt>Total Lines of Code</dt><dd>%s (%d added, %d removed)</dd>' % (data.getTotalLOC(), data.total_lines_added, data.total_lines_removed))
		f.write('<dt>Total Commits</dt><dd>%s (average %.1f commits per active day, %.1f per all days)</dd>' % (data.getTotalCommits(), float(data.getTotalCommits()) / len(data.getActiveDays()), float(data.getTotalCommits()) / data.getCommitDeltaDays()))
		f.write('<dt>Authors</dt><dd>%s</dd>' % data.getTotalAuthors())
		f.write('</dl>')

		f.write('</body>\n</html>')
		f.close()

		###
		# Activity
		f = open(path + '/activity.html', 'w')
		self.printHeader(f)
		f.write('<h1>Activity</h1>')
		self.printNav(f)

		#f.write('<h2>Last 30 days</h2>')

		#f.write('<h2>Last 12 months</h2>')

		# Weekly activity
		WEEKS = 32
		f.write(html_header(2, 'Weekly activity'))
		f.write('<p>Last %d weeks</p>' % WEEKS)

		# generate weeks to show (previous N weeks from now)
		now = datetime.datetime.now()
		deltaweek = datetime.timedelta(7)
		weeks = []
		stampcur = now
		for i in range(0, WEEKS):
			weeks.insert(0, stampcur.strftime('%Y-%W'))
			stampcur -= deltaweek

		# top row: commits & bar
		f.write('<table class="noborders"><tr>')
		for i in range(0, WEEKS):
			commits = 0
			if weeks[i] in data.activity_by_year_week:
				commits = data.activity_by_year_week[weeks[i]]

			percentage = 0
			if weeks[i] in data.activity_by_year_week:
				percentage = float(data.activity_by_year_week[weeks[i]]) / data.activity_by_year_week_peak
			height = max(1, int(200 * percentage))
			f.write('<td style="text-align: center; vertical-align: bottom">%d<div style="display: block; background-color: red; width: 20px; height: %dpx"></div></td>' % (commits, height))

		# bottom row: year/week
		f.write('</tr><tr>')
		for i in range(0, WEEKS):
			f.write('<td>%s</td>' % (WEEKS - i))
		f.write('</tr></table>')

		# Hour of Day
		f.write(html_header(2, 'Hour of Day'))
		hour_of_day = data.getActivityByHourOfDay()
		f.write('<table><tr><th>Hour</th>')
		for i in range(0, 24):
			f.write('<th>%d</th>' % i)
		f.write('</tr>\n<tr><th>Commits</th>')
		fp = open(path + '/hour_of_day.dat', 'w')
		for i in range(0, 24):
			if i in hour_of_day:
				r = 127 + int((float(hour_of_day[i]) / data.activity_by_hour_of_day_busiest) * 128)
				f.write('<td style="background-color: rgb(%d, 0, 0)">%d</td>' % (r, hour_of_day[i]))
				fp.write('%d %d\n' % (i, hour_of_day[i]))
			else:
				f.write('<td>0</td>')
				fp.write('%d 0\n' % i)
		fp.close()
		f.write('</tr>\n<tr><th>%</th>')
		totalcommits = data.getTotalCommits()
		for i in range(0, 24):
			if i in hour_of_day:
				r = 127 + int((float(hour_of_day[i]) / data.activity_by_hour_of_day_busiest) * 128)
				f.write('<td style="background-color: rgb(%d, 0, 0)">%.2f</td>' % (r, (100.0 * hour_of_day[i]) / totalcommits))
			else:
				f.write('<td>0.00</td>')
